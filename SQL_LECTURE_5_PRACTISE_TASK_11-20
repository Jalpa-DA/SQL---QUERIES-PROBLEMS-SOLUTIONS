---Task 18 — Customers With More Than One Order----

/*

Find customers who have placed more than one order.

Display:

Customer ID
Customer Name
Number of Orders
Use:

JOIN
GROUP BY
COUNT()
HAVING
*/

SELECT C.CUSTOMER_ID, C.CUSTOMER_NAME,
COUNT(ORDER_ID) AS NUMBER_OF_ORDERS
FROM JALPA_CUSTOMERS AS C
FULL JOIN JALPA_ORDERS AS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
GROUP BY C.CUSTOMER_ID, C.CUSTOMER_NAME
HAVING COUNT(ORDER_ID) > 1
;

SELECT C.CUSTOMER_ID, C.CUSTOMER_NAME,
COUNT(ORDER_ID) AS NUMBER_OF_ORDERS
FROM JALPA_CUSTOMERS AS C
FULL JOIN JALPA_ORDERS AS O
ON C.CUSTOMER_ID = O.CUSTOMER_ID
GROUP BY C.CUSTOMER_ID, C.CUSTOMER_NAME
HAVING COUNT(ORDER_ID) >= 1
;

---Task 19 — Compare Matching and Unmatched Records----

/*

Using FULL OUTER JOIN, identify:

Customers who have orders
Customers who do not have orders
Orders whose customers do not exist
Display the appropriate customer and order information.


*/
--SHOWS BOTH CUSTOMERS AND ORDERS THAT ARE NULL--

SELECT C.CUSTOMER_NAME, O.PRODUCT_NAME, O.QUANTITY, O.AMOUNT
FROM Jalpa_Customers AS C
FULL JOIN Jalpa_Orders AS O
ON C.customer_id = O.customer_id
;

--SHOWS CUSTOMERS THAT ARE NOT NULL---

SELECT C.CUSTOMER_NAME, O.PRODUCT_NAME, O.QUANTITY, O.AMOUNT
FROM Jalpa_Customers AS C
FULL JOIN Jalpa_Orders AS O
ON C.customer_id = O.customer_id
WHERE C.customer_id IS NOT NULL 
;

--SHOWS CUSTOMERS THAT ARE NULL---

SELECT C.CUSTOMER_NAME, O.PRODUCT_NAME, O.QUANTITY, O.AMOUNT
FROM Jalpa_Customers AS C
FULL JOIN Jalpa_Orders AS O
ON C.customer_id = O.customer_id
WHERE C.customer_id IS NULL
;


--SHOWS CUSTOMERS AND ORDERS ARE NOT NULL---

SELECT C.CUSTOMER_NAME, O.PRODUCT_NAME, O.QUANTITY, O.AMOUNT
FROM Jalpa_Customers AS C
FULL JOIN Jalpa_Orders AS O
ON C.customer_id = O.customer_id
WHERE C.customer_id IS NOT NULL AND O.order_id IS NOT NULL
;

--SHOWS CUSTOMERS AND ORDERS ARE NULL---

SELECT C.CUSTOMER_NAME, O.PRODUCT_NAME, O.QUANTITY, O.AMOUNT
FROM Jalpa_Customers AS C
FULL JOIN Jalpa_Orders AS O
ON C.customer_id = O.customer_id
WHERE C.customer_id IS NULL OR O.order_id IS NULL
;


---Task 20 — Business Order Report----

/*

Create a complete order report using INNER JOIN.

The report should contain:

Customer ID
Customer Name
City
Order ID
Product Name
Quantity
Amount
Total Value
Calculate:

Total Value = Quantity × Amount

*/

SELECT C.CUSTOMER_ID, C.CUSTOMER_NAME, C.CITY, O.ORDER_ID, O.PRODUCT_NAME, O.QUANTITY, O.AMOUNT,
SUM(QUANTITY*AMOUNT) AS TOTAL_VALUE
FROM Jalpa_Customers AS C
INNER JOIN Jalpa_Orders AS O
ON C.customer_id = O.customer_id
GROUP BY C.CUSTOMER_ID, C.CUSTOMER_NAME, C.CITY, O.ORDER_ID, O.PRODUCT_NAME, O.QUANTITY, O.AMOUNT
;




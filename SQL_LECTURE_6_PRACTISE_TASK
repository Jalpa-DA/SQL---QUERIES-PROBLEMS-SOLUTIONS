--Task 25 — Customer Sales Leaderboard Dataset--
/*
Management wants a customer performance dataset for the monthly business review.

Generate:

Customer ID
Customer Name
City
Number of Orders
Total Quantity Purchased
Total Revenue
Average Order Value
Maximum Order Value
Only customers with at least 3 orders should be included.

Sort the output by:

Total Revenue
Number of Orders
Average Order Value
All in descending order.

*/

select C.Customer_ID, C.Customer_Name, C.City,
count(order_id) as Number_of_Orders,
sum(quantity) as Total_Quantity_Purchased,
sum(amount) as Total_Revenue,
avg(amount) as Average_Order_Value,
max(amount) as Maximum_Order_Value
from all_customers as c
left join all_orders as O
on c.customer_id = o.customer_id
group by c.customer_id, C.customer_name, c.City
having count(order_id) = > 3
order by Total_Revenue, Number_of_Orders, Average_Order_Value desc
;

--Task 26 — Product Business Review--
/*
The Product Management team is conducting a quarterly product review.

Generate:

Product Name
Number of Orders
Total Quantity Sold
Total Revenue
Average Order Value
Maximum Order Value
Only products with at least 5 orders and total revenue above ₹2,00,000 should be included.

*/

SELECT P.PRODUCT_NAME,
COUNT(ORDER_ID) AS NUMBER_OF_ORDERS,
SUM(QUANTITY) AS TOTAL_QUANTITY_SOLD,
SUM(AMOUNT) AS TOTAL_REVENUE,
AVG(AMOUNT) AS AVG_ORDER_VALUE,
MAX(AMOUNT) AS MAX_ORDER_VALUE
FROM ALL_ORDERS AS O
LEFT JOIN PRODUCTS AS P 
ON O.PRODUCT_NAME = P.PRODUCT_NAME
GROUP BY O.PRODUCT_NAME
HAVING COUNT(ORDER_ID) >= 5 AND TOTAL_REVENUE > 200000
;

